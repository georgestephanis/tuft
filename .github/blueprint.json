{
    "$schema": "https://playground.wordpress.net/blueprint-schema.json",
    "landingPage": "/demo/",
    "preferredVersions": {
        "php": "8.2",
        "wp": "latest"
    },
    "steps": [
        {
            "step": "login",
            "username": "admin",
            "password": "password"
        },
        {
            "step": "installPlugin",
            "pluginData": {
                "resource": "wordpress.org/plugins",
                "slug": "alpaca-issue-tracker"
            },
            "options": {
                "activate": true
            }
        },
        {
            "step": "installPlugin",
            "pluginData": {
                "resource": "git:directory",
                "url": "https://github.com/georgestephanis/tuft",
                "ref": "HEAD",
                "path": "/"
            },
            "options": {
                "activate": true,
                "targetFolderName": "tuft"
            }
        },
        {
            "step": "setSiteOptions",
            "options": {
                "blogname": "Tuft Demo"
            }
        },
        {
            "step": "runPHP",
            "code": "<?php require '/wordpress/wp-load.php'; include_once WP_PLUGIN_DIR . '/tuft/.github/setup.php';"
        }
    ]
}
